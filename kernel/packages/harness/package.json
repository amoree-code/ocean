{
  "name": "@amoree-code/ocean",
  "description": "Local-first memory, tasks and session capture shared by every AI coding client: one private workspace for Claude, Codex, Gemini and more.",
  "version": "1.5.0",
  "private": false,
  "license": "MIT",
  "author": "AMEER ABDULKAREEM JABBAR LAMI",
  "homepage": "https://github.com/amoree-code/ocean#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoree-code/ocean.git",
    "directory": "packages/harness"
  },
  "bugs": {
    "url": "https://github.com/amoree-code/ocean/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "memory",
    "mcp",
    "claude",
    "codex",
    "gemini",
    "local-first"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "market",
    "ocean-marketplace.json"
  ],
  "bin": {
    "ocean": "./dist/main.js"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "check:skills": "node scripts/validate-skills.mjs && node scripts/validate-skill-paths.mjs && node scripts/generate-skills-index.mjs --check && node scripts/generate-marketplace-index.mjs --check",
    "generate:skills": "node scripts/generate-skills-index.mjs && node scripts/generate-marketplace-index.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "pnpm build && node --import ./tests/clear-ocean-env.mjs --test --test-concurrency=1 --test-timeout=30000 tests/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "playwright-core": "^1.48.0",
    "zod": "^4.6.5",
    "@ocean/core": "workspace:*",
    "@ocean/market": "workspace:*",
    "@ocean/brain": "workspace:*",
    "@ocean/context": "workspace:*",
    "@ocean/loop": "workspace:*",
    "@ocean/services": "workspace:*"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
