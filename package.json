{
  "name": "ocean-monorepo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter \"ocean...\" run build",
    "dev": "pnpm --filter \"ocean^...\" run build && pnpm --filter ocean run dev",
    "start": "pnpm build && pnpm --filter ocean run start",
    "typecheck": "pnpm --filter \"ocean^...\" run build && pnpm --filter ocean run typecheck",
    "typecheck:watch": "pnpm --filter ocean run typecheck:watch",
    "check:skills": "pnpm --filter ocean run check:skills",
    "generate:skills": "pnpm --filter ocean run generate:skills",
    "check:privacy": "node scripts/scan-privacy.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:tasks": "node packages/harness/scripts/validate-tasks.mjs",
    "check:package": "node scripts/validate-package.mjs",
    "check:system": "sh scripts/health-check.sh",
    "check:providers": "node scripts/provider-smoke.mjs",
    "check:style": "biome check .",
    "check:unused": "knip --include files,dependencies,devDependencies,unlisted,binaries,unresolved",
    "check:deps": "depcruise packages/*/src --config .dependency-cruiser.cjs --output-type err",
    "check": "pnpm typecheck && pnpm check:style && pnpm check:unused && pnpm check:deps && pnpm check:privacy && pnpm check:skills && pnpm check:tasks && pnpm check:package && pnpm check:system",
    "test": "pnpm build && pnpm --filter ocean run test",
    "prepare": "node scripts/prepare-hooks.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "dependency-cruiser": "18.5.0",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14"
  }
}
