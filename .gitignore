# ~/ocean — one public repo (T-310). The root is the owner's workspace, which holds private
# data, so this file is a WHITELIST: everything is ignored unless listed below. Only the engine
# (kernel/) ships with content; every workspace directory ships as an empty .gitkeep so the
# structure is visible while its files never are.

/*

!/.gitignore
!/README.md
!/lefthook.yml
!/.github/
!/kernel/

# --- workspace structure: directories and .gitkeep only, never their files ---
!/00-inbox/
!/01-daily/
!/02-personal/
!/03-professional/
!/04-projects/
!/05-knowledge/
!/06-templates/
!/charter/
!/bridge/
!/.index/

/00-inbox/**
/01-daily/**
/02-personal/**
/03-professional/**
/04-projects/**
/05-knowledge/**
/06-templates/**
/charter/**
/bridge/**
/.index/**

!/00-inbox/**/
!/01-daily/**/
!/02-personal/**/
!/03-professional/**/
!/04-projects/**/
!/05-knowledge/**/
!/06-templates/**/
!/charter/**/
!/bridge/**/
!/.index/**/

!/00-inbox/**/.gitkeep
!/01-daily/**/.gitkeep
!/02-personal/**/.gitkeep
!/03-professional/**/.gitkeep
!/04-projects/**/.gitkeep
!/05-knowledge/**/.gitkeep
!/06-templates/**/.gitkeep
!/charter/**/.gitkeep
!/bridge/**/.gitkeep
!/.index/**/.gitkeep
