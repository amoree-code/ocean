{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!node_modules",
      "!!graft",
      "!!graphify-out",
      "!!packages/harness/tests/_tmp",
      "!!bridge",
      "!!.claude/helpers",
      "!!.cursor/hooks",
      "!!.claude/settings.json",
      "!!.cursor/mcp.json",
      "!!.gemini/settings.json",
      "!!.mcp.json",
      "!!opencode.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
