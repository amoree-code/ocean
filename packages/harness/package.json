{
  "name": "ocean",
  "version": "0.3.7",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates",
    "skills"
  ],
  "bin": {
    "ocean": "./dist/main.js"
  },
  "scripts": {
    "prebuild": "node scripts/prepare-node-pty.mjs && node scripts/clean-dist.mjs",
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "check:skills": "node scripts/validate-skills.mjs && node scripts/validate-skill-paths.mjs && node scripts/generate-skills-index.mjs --check",
    "generate:skills": "node scripts/generate-skills-index.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "pnpm build && node --import ./tests/clear-ocean-env.mjs --test --test-concurrency=1 --test-timeout=30000 tests/*.test.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "playwright-core": "^1.48.0",
    "sqlite-vec": "0.1.9",
    "zod": "^4.6.5",
    "@ocean/core": "workspace:*",
    "@ocean/market": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
