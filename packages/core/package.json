{
  "name": "@ocean/core",
  "version": "0.3.7",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./domain/*.js": {
      "types": "./dist/domain/*.d.ts",
      "import": "./dist/domain/*.js"
    },
    "./shared/*.js": {
      "types": "./dist/shared/*.d.ts",
      "import": "./dist/shared/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
